{
  "name": "frame-extension",
  "version": "0.12.1",
  "packageManager": "npm@11.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorphex/frame-extension.git"
  },
  "description": "Frame Companion Extension",
  "main": "src",
  "scripts": {
    "setup:ci": "node scripts/check-toolchain.mjs && npm ci",
    "test": "npm run lint && npm run format:check && npm run test:unit",
    "test:unit": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm test && npm run build && node scripts/verify-dist.mjs",
    "build": "rimraf ./dist && webpack --config webpack.config.js && node ./src/copy-static.js",
    "bundle": "webpack --config webpack.config.js",
    "watch": "npm run build && webpack --config webpack.dev.config.js"
  },
  "author": "Frame Labs, Inc.",
  "license": "GPL-3.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.12.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "dependencies": {
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "babel-loader": "10.1.1",
    "events": "3.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-restore": "0.6.2",
    "styled-components": "6.4.4"
  },
  "overrides": {
    "brace-expansion@<=1.1.16": "1.1.17",
    "ws@>=8.0.0 <8.21.1": "8.21.1",
    "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
    "lodash@>=4.0.0 <4.18.1": "4.18.1"
  }
}
