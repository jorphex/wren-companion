{
  "name": "frame-extension",
  "version": "0.12.1",
  "packageManager": "npm@11.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorphex/frame-extension.git"
  },
  "description": "Frame Companion Extension",
  "main": "src",
  "scripts": {
    "setup:ci": "node scripts/check-toolchain.mjs && npm ci",
    "test": "standard",
    "verify": "npm test && npm run build && node scripts/verify-dist.mjs",
    "build": "rimraf ./dist && webpack --config webpack.config.js && node ./src/inline.js",
    "bundle": "webpack --config webpack.config.js",
    "watch": "npm run build && webpack --config webpack.dev.config.js"
  },
  "author": "Frame Labs, Inc.",
  "license": "GPL-3.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.12.0"
  },
  "devDependencies": {
    "@babel/core": "7.18.2",
    "@babel/plugin-transform-runtime": "7.18.2",
    "@babel/preset-react": "7.17.12",
    "ncp": "2.0.0",
    "rimraf": "3.0.2",
    "standard": "17.0.0",
    "terser-webpack-plugin": "5.3.3",
    "webpack": "5.73.0",
    "webpack-cli": "4.9.2",
    "webpack-dev-server": "4.9.2"
  },
  "dependencies": {
    "@babel/preset-env": "7.18.2",
    "@babel/runtime": "7.18.3",
    "babel-loader": "8.2.5",
    "eth-provider": "0.13.7",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-restore": "0.5.0",
    "styled-components": "5.3.5"
  }
}
