{
  "name": "wren-companion",
  "version": "0.1.3",
  "packageManager": "npm@11.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorphex/wren-companion.git"
  },
  "description": "Connects Ethereum apps in your browser to the Wren desktop wallet",
  "main": "src",
  "scripts": {
    "setup:ci": "node scripts/check-toolchain.mjs && npm ci",
    "audit:release": "npm audit --audit-level=high",
    "test": "npm run lint && npm run format:check && npm run test:unit",
    "test:unit": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:verify": "node scripts/verify-brand-assets.mjs",
    "store:icon": "node scripts/generate-store-icon.mjs",
    "store:screenshots": "node scripts/generate-store-screenshots.mjs",
    "verify": "npm test && npm run build && node scripts/verify-dist.mjs && npm run lint:webext",
    "lint:webext": "node scripts/lint-firefox.mjs",
    "package:browsers": "npm run verify && node scripts/package-browsers.mjs && npm run sbom:artifact && node scripts/write-checksums.mjs",
    "package:verify": "npm run sbom:verify && node scripts/verify-packages.mjs",
    "qualify:serve": "node scripts/serve-qualification.mjs",
    "qualify:browser": "node scripts/qualify-browser.mjs",
    "qualify:artifacts": "node scripts/qualify-browser.mjs --artifacts",
    "sbom:artifact": "node scripts/generate-sbom.mjs",
    "sbom:verify": "node scripts/verify-sbom.mjs",
    "build": "npm run brand:verify && rimraf ./dist && webpack --config webpack.config.js && node ./src/copy-static.js",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs && node scripts/verify-dist.mjs dist-firefox firefox",
    "bundle": "webpack --config webpack.config.js",
    "watch": "npm run build && webpack --config webpack.dev.config.js"
  },
  "author": {
    "name": "Jorphex and Wren contributors",
    "email": "jorphex@users.noreply.github.com",
    "url": "https://github.com/jorphex/wren-companion"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": "24.18.1",
    "npm": "11.12.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "9.39.5",
    "addons-linter": "10.14.0",
    "babel-loader": "10.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "events": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-restore": "0.6.2",
    "styled-components": "6.5.3"
  },
  "overrides": {
    "ws@>=8.0.0 <8.21.1": "8.21.1",
    "lodash@>=4.0.0 <4.18.1": "4.18.1",
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
