{
  "name": "Frame Community Companion",
  "version": "0.13.1",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "description": "Community-maintained companion connecting browser dapps to the Jorphex Frame desktop wallet.",
  "homepage_url": "https://github.com/jorphex/frame-extension",
  "background": {
    "service_worker": "index.js"
  },
  "action": {
    "default_title": "Frame Community Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["frame.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:1248"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{53cfd564-e246-4c76-808c-8648768988d5}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["alarms", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
