{
  "name": "Wren Companion",
  "version": "0.1.2",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "description": "Connects browser-based Ethereum and EVM dapps to the Wren desktop wallet.",
  "homepage_url": "https://github.com/jorphex/wren-companion",
  "background": {
    "service_worker": "index.js"
  },
  "action": {
    "default_title": "Wren Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["frame.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:1248"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{645ed7c6-d25f-4256-b29a-10e1e0633cf5}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "financialAndPaymentInfo",
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
